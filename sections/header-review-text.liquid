<div class="bg-[#0f172a] text-white py-2">
  <div class="page-width">
    <a href="{{ section.settings.url }}" class="flex items-center justify-center gap-2 no-underline text-white text-lg">
      <img
        src="{{ 'rating-stars.svg' |  asset_url }}"
        alt="*****"
        height="16"
        width="80">
      <span>
        {{ section.settings.text }}
      </span>
    </a>
  </div>
</div>
{% schema %}
  {
    "name": "Header Review Text",
    "settings": [
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "3800+ Reviews →"
      }, {
        "type": "url",
        "id": "url",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Header Review Text"
      }
    ]
  }
{% endschema %}